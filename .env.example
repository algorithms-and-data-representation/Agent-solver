# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model Selection
# gemini-1.5-flash: Rápido, eficiente, GRATIS
GEMINI_MODEL=gemini-1.5-flash

# Límites gratuitos de Gemini:
# - gemini-1.5-flash: 15 requests/min, 1M tokens/min, 1,500 requests/día
# - gemini-1.5-pro: 2 requests/min, 32K tokens/min, 50 requests/día

# Agent Configuration
AGENT_CATEGORY=dynamic_programming
TEMPERATURE=0.3
MAX_TOKENS=8192

# Logging
LOG_LEVEL=INFO
LOG_FILE=agent.log

# Testing
RUN_TESTS_ON_STARTUP=false

# Anthropic Claude (Alternativa)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
